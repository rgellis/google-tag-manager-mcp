# OAuth installed-app credentials. Mint the refresh token with
# `uv run scripts/get_refresh_token.py`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TAG_MANAGER_REFRESH_TOKEN=

# Request only the readonly scope and refuse every mutating tool.
# Worth enabling anywhere this server is exposed to an agent that has no
# business publishing to a live site.
TAG_MANAGER_READ_ONLY=false
